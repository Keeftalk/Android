<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- FAB Style Circle with Gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#00CCCC"
                android:endColor="#7D5CFF"
                android:type="linear" />
            <size
                android:width="108dp"
                android:height="108dp" />
        </shape>
    </item>

    <!-- App Icon / Logo -->
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:top="24dp"
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp" />
</layer-list>