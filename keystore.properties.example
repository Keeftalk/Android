# ==========================================
# Keystore Signing Configuration Template for Keeftalk
# ==========================================
# Copy this file to 'keystore.properties' in the root directory to sign release builds.
# DO NOT commit 'keystore.properties' to version control.
#
# Note: Debug builds automatically use the standard Android debug keystore.
# Release builds can be configured using this file OR using environment variables:
# KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=YOUR_KEY_ALIAS
storeFile=/path/to/your/keystore.jks
